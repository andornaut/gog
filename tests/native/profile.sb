(version 1)
(allow default)
(deny file-write*)
(allow file-write*
    (subpath (param "CHECKOUT"))
    (subpath (param "SCRATCH"))
    (literal "/dev/null")
    (literal "/dev/stdin")
    (literal "/dev/stdout")
    (literal "/dev/stderr")
    (literal "/dev/tty")
    (literal "/dev/ptmx")
    (subpath "/dev/fd")
    (regex #"^/dev/pty[a-z]+$")
    (regex #"^/dev/ttys[0-9]+$"))
